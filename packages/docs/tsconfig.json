{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "@docusaurus/module-type-aliases"]
  },
  "include": ["*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["build", ".docusaurus", "node_modules"]
}
