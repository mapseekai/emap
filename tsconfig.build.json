{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src"
  },
  "include": ["src/index.ts", "src/arrow/index.ts", "src/duckdb/index.ts", "src/types/**/*.d.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
