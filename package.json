{
  "name": "@mapseekai/emap",
  "version": "0.11.2",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.18 <25"
  },
  "browserslist": [
    "Chrome >= 109",
    "Edge >= 109",
    "Firefox >= 115",
    "Safari >= 16.4"
  ],
  "description": "A modern, decoupled rendering engine for mapshaper data",
  "main": "dist/emap.mjs",
  "module": "dist/emap.mjs",
  "browser": "dist/emap.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "style.css": [
        "dist/style.css.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/emap.mjs"
    },
    "./arrow": {
      "types": "./dist/integrations/arrow/index.d.ts",
      "import": "./dist/emap-arrow.mjs"
    },
    "./duckdb": {
      "types": "./dist/integrations/duckdb/index.d.ts",
      "import": "./dist/emap-duckdb.mjs",
      "default": "./dist/emap-duckdb.mjs"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/emap.css"
    },
    "./dist/emap-worker.js": "./dist/emap-worker.js",
    "./dist/mapshaper-vendor.js": "./dist/mapshaper-vendor.js",
    "./dist/mapshaper-vendor.mjs": "./dist/mapshaper-vendor.mjs",
    "./dist/emap.js": "./dist/emap.js",
    "./dist/emap-arrow.js": "./dist/emap-arrow.js",
    "./dist/emap-arrow.mjs": "./dist/emap-arrow.mjs",
    "./package.json": "./package.json",
    "./context": {
      "types": "./dist/runtime/context/index.d.ts",
      "import": "./dist/emap-context.mjs"
    },
    "./services": {
      "types": "./dist/runtime/services/index.d.ts",
      "import": "./dist/emap-services.mjs"
    },
    "./providers": {
      "types": "./dist/runtime/providers/index.d.ts",
      "import": "./dist/emap-providers.mjs"
    },
    "./plugins": {
      "types": "./dist/runtime/plugins/index.d.ts",
      "import": "./dist/emap-plugins.mjs"
    },
    "./presets": {
      "types": "./dist/runtime/presets/index.d.ts",
      "import": "./dist/emap-presets.mjs"
    },
    "./ai": {
      "types": "./dist/runtime/ai/index.d.ts",
      "import": "./dist/emap-ai.mjs"
    },
    "./maplibre": {
      "types": "./dist/integrations/maplibre/index.d.ts",
      "import": "./dist/emap-maplibre.mjs"
    }
  },
  "sideEffects": [
    "*.css",
    "./src/integrations/mapshaper/browser-shim.ts",
    "./dist/mapshaper-vendor.js",
    "./dist/mapshaper-vendor.mjs",
    "./dist/emap-arrow.js"
  ],
  "files": [
    "dist/emap.js",
    "dist/emap.mjs",
    "dist/emap-*.mjs",
    "dist/emap-worker.js",
    "dist/emap-arrow.js",
    "dist/emap-arrow.mjs",
    "dist/emap-duckdb.mjs",
    "dist/mapshaper-vendor.js",
    "dist/mapshaper-vendor.mjs",
    "dist/emap.css",
    "dist/**/*.d.ts",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "rollup -c --environment BUILD:development -w",
    "dev-build": "rollup -c --environment BUILD:development",
    "prebuild": "npm run clean",
    "build": "rollup -c --environment BUILD:production && tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:bundle": "vitest run test/build/bundle-self-contained.test.ts test/build/package-exports.test.ts",
    "bundle:smoke": "node scripts/check-bundle-smoke.mjs",
    "test:rendering": "pnpm run build && node scripts/check-audit-rendering.mjs",
    "browser:install": "playwright install --with-deps chrome firefox webkit",
    "test:browser": "pnpm run examples:build && playwright test",
    "test:browser:chrome": "pnpm run examples:build && playwright test --project=chrome",
    "browser:check": "playwright test && node scripts/check-audit-rendering.mjs --all-browsers",
    "test:duckdb": "DUCKDB_WASM_INTEGRATION=1 vitest run src/integrations/duckdb test/integration/duckdb",
    "audit:prod": "node scripts/audit-production-dependencies.mjs",
    "security:audit": "pnpm run audit:prod",
    "api:check-surface": "node scripts/check-public-api-surface.mjs",
    "docs:clean": "node -e \"require('node:fs').rmSync('packages/docs/.docusaurus',{recursive:true,force:true})\"",
    "docs:dev": "pnpm run docs:clean && pnpm run api:build && pnpm --filter @mapseekai/emap-docs start",
    "docs:preview": "pnpm run build && pnpm run examples:build && pnpm run docs:build && pnpm run docs:compose-examples && node scripts/preview-docs.mjs",
    "docs:build": "pnpm run api:build && pnpm --filter @mapseekai/emap-docs build",
    "api:build": "typedoc --options typedoc.json",
    "examples:dev": "pnpm --filter @mapseekai/emap-examples dev",
    "examples:build": "pnpm --filter @mapseekai/emap-examples build",
    "examples:build:cdn": "node scripts/build-examples-cdn.mjs",
    "docs:compose-examples": "node scripts/compose-docs-release.mjs",
    "docs:check-i18n": "node scripts/check-docs-i18n.mjs",
    "docs:check-api": "node scripts/check-docs-api.mjs",
    "examples:check": "node scripts/check-examples.mjs",
    "docs:verify": "npm run typecheck && npm run typecheck:contracts && npm run typecheck:examples && npm run test-layout:check && npm run api:check-surface && npm run examples:build && npm run docs:build && npm run docs:compose-examples && npm run docs:check-i18n && npm run docs:check-api && npm run examples:check",
    "release:verify": "npm run format:check && npm run typecheck && npm run typecheck:contracts && npm run typecheck:examples && npm run test-layout:check && npm run api:check-surface && npm run architecture:check && npm run capabilities:check && npm run build && npm run bundle:smoke && npm run test:run && npm run test:duckdb && npm run examples:build && npm run docs:build && npm run docs:compose-examples && npm run docs:check-i18n && npm run docs:check-api && npm run examples:check && npm run browser:check && pnpm pack --dry-run && npm run audit:prod",
    "prepublishOnly": "npm run release:verify",
    "capabilities:generate": "node scripts/generate-capability-schemas.mjs",
    "capabilities:check": "node scripts/generate-capability-schemas.mjs --check",
    "architecture:check": "node scripts/check-plugin-architecture.mjs",
    "typecheck:contracts": "tsc -p tsconfig.type-tests.json --noEmit",
    "test-layout:check": "node scripts/check-test-layout.mjs",
    "typecheck:examples": "tsc -p packages/examples/tsconfig.json --noEmit"
  },
  "keywords": [
    "mapshaper",
    "emap",
    "gis",
    "renderer",
    "canvas"
  ],
  "author": "mapseekai",
  "license": "MPL-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapseekai/emap.git"
  },
  "bugs": {
    "url": "https://github.com/mapseekai/emap/issues"
  },
  "homepage": "https://github.com/mapseekai/emap#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@duckdb/duckdb-wasm": "1.33.1-dev64.0",
    "@playwright/test": "1.62.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@zwishing/epsg-index": "^3.0.0",
    "apache-arrow": "^17.0.0",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.0",
    "maplibre-gl": "^6.4.1",
    "parquet-wasm": "^0.7.1",
    "rollup": "^4.0.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-postcss": "^4.0.2",
    "typedoc": "^0.28.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@tmcw/togeojson": "^5.8.1",
    "cordis": "4.0.0-rc.10",
    "fflate": "^0.8.3",
    "flatbush": "^4.5.0",
    "geographiclib-geodesic": "^2.2.0",
    "kdbush": "^4.0.2",
    "mapshaper": "^0.6.113",
    "mproj": "^0.1.2"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev64.0",
    "apache-arrow": "^17.0.0",
    "maplibre-gl": "^6.4.1",
    "parquet-wasm": "^0.7.1"
  },
  "peerDependenciesMeta": {
    "@duckdb/duckdb-wasm": {
      "optional": true
    },
    "apache-arrow": {
      "optional": true
    },
    "parquet-wasm": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  }
}
