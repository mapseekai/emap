{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/arrow/index.ts", "src/duckdb/index.ts"],
  "treatWarningsAsErrors": true,
  "intentionallyNotExported": [
    "AttributeOps",
    "CircleLayerSpecification",
    "CorePainter",
    "CrsProjjsonLookup",
    "CrsStringToProjjsonOptions",
    "DrawOverlayState",
    "DUCKDB_RELATION_OPERATION_SPECS",
    "DuckDbLayerSuccess",
    "DuckDbNamedAttributeOperationSpec",
    "EditHandlerHost",
    "EditMode",
    "EditPainter",
    "EditSessions",
    "EditVertexState",
    "EmapHostInternal",
    "ExportedPathData",
    "FeatureCreateCommandOptions",
    "FillLayerPaint",
    "FillLayerSpecification",
    "LayerRegistry",
    "LineLayerSpecification",
    "MapshaperOps",
    "MeasurementContextResolver",
    "MeasurementOverlayState",
    "MutableTopologySource",
    "NormalizedDuckDbBufferOptions",
    "OverlayDuckDbFunction",
    "ParquetWasmWriterPropertiesBuilder",
    "ParsedCommand",
    "ParsedCommandWire",
    "PathImporterHandle",
    "Point",
    "PointToShapeInfo",
    "PolygonFillOptions",
    "PreparedReprojection",
    "RelationDuckDbFunction",
    "RenderRequest",
    "SelectionHandlerHost",
    "TransactionInternal",
    "VertexDeleteCommandOptions",
    "VertexInsertCommandOptions",
    "VertexMoveCommandOptions",
    "WasmInput",
    "WorkerRoutingFn"
  ],
  "outputs": [
    { "name": "html", "path": "packages/docs/static/api" },
    { "name": "json", "path": "packages/docs/static/api/reflections.json" }
  ],
  "plugin": ["./scripts/typedoc-hide-internals.mjs"],
  "excludeInternal": true,
  "readme": "none",
  "disableGit": true,
  "sourceLinkTemplate": "https://github.com/mapseekai/emap/blob/master/src/{path}#L{line}"
}
