{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/integrations/arrow/index.ts",
    "src/integrations/duckdb/index.ts",
    "src/runtime/context/index.ts",
    "src/runtime/services/index.ts",
    "src/runtime/providers/index.ts",
    "src/runtime/plugins/index.ts",
    "src/runtime/presets/index.ts",
    "src/runtime/ai/index.ts",
    "src/integrations/maplibre/index.ts",
    "src/integrations/geopackage/index.ts",
    "src/integrations/geotiff/index.ts"
  ],
  "treatWarningsAsErrors": true,
  "intentionallyNotExported": [
    "AttributeOps",
    "CanvasFrameOptions",
    "CircleLayerSpecification",
    "CorePainter",
    "PainterCreationOptions",
    "CrsProjjsonLookup",
    "CrsStringToProjjsonOptions",
    "DrawOverlayState",
    "DuckDbCrsRequirement",
    "DuckDbGeometryKind",
    "DuckDbParameterType",
    "DuckDbToolCost",
    "EditHandlerHost",
    "EditMode",
    "EditPainter",
    "EditSessions",
    "EditVertexState",
    "EmapHostInternal",
    "ExportedPathData",
    "FeatureCreateCommandOptions",
    "FillLayerPaint",
    "FillLayerSpecification",
    "LayerRegistry",
    "LayerSuccess",
    "LineLayerSpecification",
    "MapshaperOps",
    "MeasurementContextResolver",
    "MeasurementOverlayState",
    "MutableTopologySource",
    "OverlayOptions",
    "ProcessingOptions",
    "RelationOperationId",
    "ParquetWasmWriterPropertiesBuilder",
    "ParsedCommand",
    "ParsedCommandWire",
    "PathImporterHandle",
    "Point",
    "PointToShapeInfo",
    "PolygonFillOptions",
    "PreparedReprojection",
    "RenderRequest",
    "SelectionHandlerHost",
    "TransactionInternal",
    "TOOLS",
    "VertexDeleteCommandOptions",
    "VertexInsertCommandOptions",
    "VertexMoveCommandOptions",
    "WasmInput",
    "WorkerRoutingFn"
  ],
  "outputs": [
    {
      "name": "html",
      "path": "packages/docs/static/api"
    },
    {
      "name": "json",
      "path": "packages/docs/static/api/reflections.json"
    }
  ],
  "plugin": ["./scripts/typedoc-hide-internals.mjs"],
  "excludeInternal": true,
  "readme": "none",
  "disableGit": true,
  "sourceLinkTemplate": "https://github.com/mapseekai/emap/blob/master/src/{path}#L{line}"
}
